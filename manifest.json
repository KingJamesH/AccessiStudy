{
    "manifest_version": 3,
    "name": "WebAble",
    "version": "3.0",
    "description": "Accessibility and AI to let EVERYONE access the internet",
    "permissions": [
      "activeTab",
      "storage",
      "scripting",
      "webRequest",
      "contextMenus"
    ],
    "host_permissions": [
      "https://generativelanguage.googleapis.com/*"
    ],
    "web_accessible_resources": [{
      "resources": [
        "contentScript.js",
        "styles.css",
        "config.local.json",
        "services/*",
        "fonts/OpenDyslexic-Regular.otf",
        "fonts/OpenDyslexic-Bold.otf",
        "fonts/OpenDyslexic-Italic.otf",
        "fonts/OpenDyslexic-BoldItalic.otf",
        "notes.html",
        "notes.js",
        "popup.js"
      ],
      "matches": ["<all_urls>"]
    }],
    "action": {
      "default_popup": "popup.html"
    },
    "background": {
      "service_worker": "background.js"
    },
    "content_scripts": []
  }
  