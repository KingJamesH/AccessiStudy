{
    "manifest_version": 3,
    "name": "WebAble",
    "version": "3.0",
    "description": "Accessibility and AI to let EVERYONE access the internet",
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "permissions": [
      "activeTab",
      "storage",
      "scripting",
      "webRequest",
      "contextMenus"
    ],
    "host_permissions": [
      "https://generativelanguage.googleapis.com/*"
    ],
    "web_accessible_resources": [{
      "resources": [
        "contentScript.js",
        "styles.css",
        "config.local.json",
        "fonts/OpenDyslexic-Regular.otf",
        "fonts/OpenDyslexic-Bold.otf",
        "fonts/OpenDyslexic-Italic.otf",
        "fonts/OpenDyslexic-BoldItalic.otf",
        "notes.html",
        "notes.js",
        "popup.js",
        "icons/*"
      ],
      "matches": ["<all_urls>"]
    }],
    "action": {
      "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "background": {
      "service_worker": "background.js"
    },
    "content_scripts": []
}
  